# Client environment template.
# This file is the source of truth for browser/Vite configuration names.
# Let `pnpm setup:local` generate `client/.env.local` for Docker-local dev.
# Client/Vite precedence: process env > .env.local > .env.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local dev-server proxy target. Vercel production uses same-origin /api.
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Optional Slack OAuth fallback. If unset, the current browser origin is used.
VITE_SLACK_CALLBACK_URL=http://localhost:5173/

# PostHog product analytics. Leave VITE_POSTHOG_KEY empty to disable it
# entirely (no posthog-js chunk is downloaded). See docs/analytics.md.
# Use the *project* API key (phc_...) - it is public by design.
VITE_POSTHOG_KEY=
# EU cloud by default. Set to /ingest to route through the app's own
# same-origin reverse proxy (survives ad blockers; see vercel.json).
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# PostHog app URL, used for toolbar links when VITE_POSTHOG_HOST is a proxy.
VITE_POSTHOG_UI_HOST=https://eu.posthog.com
# Opt-ins, all off by default because this app renders sensitive member data.
VITE_POSTHOG_AUTOCAPTURE=false
VITE_POSTHOG_SESSION_RECORDING=false
VITE_POSTHOG_IDENTIFY_EMAIL=false
VITE_POSTHOG_DEBUG=false

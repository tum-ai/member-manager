{
	"name": "@member-manager/server",
	"version": "1.0.0",
	"description": "Backend API for Member Manager",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"dev:local": "tsx watch src/index.ts",
		"build": "tsc",
		"backfill:encryption": "tsx src/scripts/rotateSensitiveData.ts --apply --plaintext-only",
		"rotate:encryption": "tsx src/scripts/rotateSensitiveData.ts",
		"backfill:member-cvs": "tsx src/scripts/backfillMemberCvs.ts",
		"start": "node dist/index.js",
		"lint": "biome check .",
		"lint:apply": "biome check . --write",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test test/**/*.test.ts",
		"test:coverage": "c8 --reporter=text-summary --reporter=lcov --reporter=json-summary --all --src=src --check-coverage --lines=70 --functions=70 --branches=50 --statements=70 tsx --test test/**/*.test.ts"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.1",
		"@fastify/multipart": "^10.1.0",
		"@fastify/rate-limit": "^10.3.0",
		"@member-manager/shared": "workspace:*",
		"@supabase/supabase-js": "^2.115.0",
		"@vercel/functions": "^3.9.5",
		"@vercel/sandbox": "^3.2.1",
		"docx-templates": "^4.14.1",
		"dotenv": "^16.6.1",
		"fastify": "^5.12.3",
		"fastify-plugin": "^5.1.0",
		"jszip": "^3.10.1",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.3.289",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"c8": "^11.0.0",
		"cross-env": "^10.1.0",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3"
	}
}
